<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101214"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/admin_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hudl Kiosk Administration"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/admin_organization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Hudl organization URL or ID"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E969D" />

        <EditText
            android:id="@+id/admin_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Refresh interval (10–300 seconds)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E969D" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_auto_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Automatically play live events"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_interrupt_vod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interrupt on-demand video when a live event begins"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_return_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return to the broadcast menu after playback"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_keep_awake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the screen awake"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_extreme_kiosk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Extreme accessibility lockdown"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/admin_lockdown_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#C8D1D8"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/admin_accessibility_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accessibility settings" />

            <Button
                android:id="@+id/admin_lock_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Lock now" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#19242C"
            android:padding="18dp"
            android:text="READ-ONLY MANAGEMENT&#10;Open http://&lt;device IP&gt;:8787 from a browser on the same local network."
            android:textColor="#C8D1D8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ADMIN PIN"
            android:textColor="#8CC63F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/admin_new_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="New PIN (leave blank to keep current)"
            android:inputType="numberPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E969D" />

        <EditText
            android:id="@+id/admin_confirm_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm new PIN"
            android:inputType="numberPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E969D" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/admin_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save settings" />

            <Button
                android:id="@+id/admin_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
