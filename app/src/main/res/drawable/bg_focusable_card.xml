<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#25331E" /><stroke android:width="3dp" android:color="#97D84D" /><corners android:radius="18dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#314425" /><stroke android:width="3dp" android:color="#B6F16F" /><corners android:radius="18dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#17222B" android:endColor="#111A21" /><stroke android:width="1dp" android:color="#2C3B47" /><corners android:radius="18dp" /></shape></item>
</selector>
